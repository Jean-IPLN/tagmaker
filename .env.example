# Imprimante ZPL (thermique, port raw TCP 9100)
ZPL_PRINTER_HOST=192.168.1.63
ZPL_PRINTER_PORT=9100

# Résolution de l'imprimante (dpi), utilisée pour la conversion mm → dots du ZPL
ZPL_RESOLUTION_DPI=203

# Formats de papier proposés dans le sélecteur « Papier » puis utilisés pour
# l'impression (largeurxlongueur en mm, séparés par des virgules, triés par
# surface croissante). Obligatoire : c'est la source de vérité de la taille
# d'étiquette — aucune autre variable de dimension n'est lue.
ZPL_PAPER_SIZES=40x25, 75x25, 100x50, 100x150

# Sous-réseau sondé pour la découverte d'imprimantes (par défaut : /24 de ZPL_PRINTER_HOST).
# ZPL_SCAN_SUBNET=192.168.1.0