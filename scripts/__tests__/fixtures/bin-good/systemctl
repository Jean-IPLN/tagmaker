#!/bin/sh
# Stub systemctl pour les tests POSIX (PATH injecté par run-install-tests.sh).
# Réponses pilotées par TAGMAKER_STUB_SYSTEMCTL_STATE / _ENABLED.

state="${TAGMAKER_STUB_SYSTEMCTL_STATE:-active}"
enabled="${TAGMAKER_STUB_SYSTEMCTL_ENABLED:-enabled}"

if [ -n "${TAGMAKER_STUB_LOG:-}" ]; then
    printf 'systemctl %s\n' "$*" >> "$TAGMAKER_STUB_LOG/calls.log"
fi

case "$1" in
  is-active)
    printf '%s\n' "$state"
    ;;
  is-enabled)
    printf '%s\n' "$enabled"
    ;;
  *)
    exit 0
    ;;
esac
exit 0