# Fixture .env example — miroir du .env.example du dépôt (tests config).
# Imprimante ZPL (thermique, port raw TCP 9100)
ZPL_PRINTER_HOST=192.168.1.63
ZPL_PRINTER_PORT=9100

# Résolution de l'imprimante (dpi), conversion mm → dots du ZPL
ZPL_RESOLUTION_DPI=203

# Formats de papier proposés (largeurxlongueur en mm, séparés par des virgules)
ZPL_PAPER_SIZES=40x25, 75x25, 100x50, 100x150